# ------------------------------------------------------------------
# Wisko DAM environment
# Copy to .env.local and fill in. NEVER commit real values.
# ------------------------------------------------------------------

# --- Supabase (from Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Service role key = admin. Server-only. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- App master encryption key ---
# Used to encrypt Backblaze secret keys before storing them in the DB.
# Generate with:  npm run gen:key   (32 random bytes, base64)
APP_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY

# --- Backblaze defaults (optional bootstrap key) ---
# You can leave these blank and add keys from the dashboard instead.
# If set, they seed the first "active" storage key on first boot.
# Use a RESTRICTED key (single bucket, read/write/delete/share only) — NOT a master key.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_ID=
B2_BUCKET_NAME=
# S3-compatible endpoint region, e.g. us-west-004 / eu-central-003.
# Find it in B2 bucket details -> "Endpoint: s3.us-west-004.backblazeb2.com"
B2_REGION=us-west-004

# Signed download URL lifetime (seconds). PRD wants 60-300.
SIGNED_URL_TTL_SECONDS=180
